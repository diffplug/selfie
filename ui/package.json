{
  "name": "selfie-ui",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "exports": {
    "./api": "./src/shared/api.ts",
    "./app": "./src/server/app.ts",
    "./regions": "./src/shared/regions.ts",
    "./notes": "./src/shared/notes.ts",
    "./local": "./src/server/local.ts",
    "./storybook": "./src/server/storybook.ts",
    "./sync": "./src/server/sync.ts",
    "./sync-api": "./src/shared/sync-api.ts"
  },
  "scripts": {
    "build": "vite build",
    "build-storybook": "node --disable-warning=ExperimentalWarning ../cli/scripts/generate-storybook-fixtures.ts && storybook build --quiet",
    "storybook": "node --disable-warning=ExperimentalWarning ../cli/scripts/generate-storybook-fixtures.ts && storybook dev -p 6007",
    "prepare": "vite build",
    "test": "pnpm typecheck && vite build --logLevel warn && vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.workerd.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.16",
    "selfie-store": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@primer/octicons-react": "19.42.0",
    "@primer/primitives": "11.10.0",
    "@primer/react": "38.43.0",
    "@storybook/icons": "2.2.0",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-is": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "storybook": "10.6.5",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "catalog:"
  }
}
