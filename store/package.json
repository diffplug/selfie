{
  "name": "selfie-store",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "exports": {
    ".": "./src/core/index.ts",
    "./adapters/d1-rest": "./src/adapters/d1-rest.ts",
    "./adapters/r2": "./src/adapters/r2.ts",
    "./adapters/sqlite": "./src/adapters/sqlite.ts",
    "./adapters/filesystem-blob": "./src/adapters/filesystem-blob.ts",
    "./adapters/sharp-codec": "./src/adapters/sharp-codec.ts"
  },
  "scripts": {
    "test": "pnpm typecheck && vitest run",
    "test:d1": "SELFIE_D1_CONTRACT=1 vitest run --project node --silent=false --no-file-parallelism test/d1-rest.real.test.ts test/render-batches.real.test.ts",
    "test:d1:renders": "SELFIE_D1_CONTRACT=1 vitest run --project node --silent=false test/render-batches.real.test.ts",
    "test:d1:workerd": "SELFIE_D1_WORKERD=1 vitest run --project workerd --silent=false test/workerd/d1.real.workerd.test.ts",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json && tsc -p tsconfig.workerd.json",
    "find-collision": "node scripts/find-collision.ts"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
