// Checks the store core and the cloud adapters with Web-standard types only and no
// Node types, so a platform import or global in them fails typecheck.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "types": []
  },
  "include": ["src/core", "src/adapters/d1-rest.ts", "src/adapters/r2.ts"]
}
